<Window x:Class="BeacomStair.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacom Stair"
        Width="520"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Beacom Stair"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Set the main stair size and Tekla profiles, then pick the wall point and stair direction."
                       Margin="0,6,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D8DCE2"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Clear stair width (mm)"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox x:Name="WidthTextBox"
                         Grid.Row="0" Grid.Column="1"
                         Height="28"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Stringer PFC"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox x:Name="StringerProfileTextBox"
                         Grid.Row="1" Grid.Column="1"
                         Height="28"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Tread plate"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox x:Name="TreadProfileTextBox"
                         Grid.Row="2" Grid.Column="1"
                         Height="28"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Tread end plate"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox x:Name="TreadEndPlateProfileTextBox"
                         Grid.Row="3" Grid.Column="1"
                         Height="28"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Handrail CHS"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox x:Name="RailProfileTextBox"
                         Grid.Row="4" Grid.Column="1"
                         Height="28"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="Landing support RSA"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBox x:Name="SupportAngleProfileTextBox"
                         Grid.Row="5" Grid.Column="1"
                         Height="28"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="#EEF2F7"
                    CornerRadius="5"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Fixed geometry"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="3170 rise  •  3500 flight run  •  1000 top landing  •  15 rises / 14 treads"
                               Foreground="#59616C"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="2,14,2,0"
                       Foreground="#59616C"
                       Text="Ready." />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Reset defaults"
                    Width="110"
                    Height="34"
                    Click="ResetDefaults_Click" />

            <Button Grid.Column="2"
                    Content="Create stair"
                    Width="125"
                    Height="38"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="CreateStair_Click" />
        </Grid>
    </Grid>
</Window>
